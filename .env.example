# ==============================================================================
# ENVIRONMENT & GENERAL CONFIGURATION
# ==============================================================================
ENVIRONMENT=staging

# ==============================================================================
# BEHAVIORAL WORKFLOW TESTING: PORTAL ENDPOINTS & CREDENTIALS
# ==============================================================================

# Developer 1: Trade Terminal
TRADE_TERMINAL_URL=https://stage.xtremenext.com/
TRADE_LOGIN_URL=https://stage.xtremenext.com/login
TRADE_USERNAME=
TRADE_PASSWORD=
TRADE_POST_LOGIN_URL_PATTERN=**/dashboard**

# Developer 2: Admin Portal
ADMIN_PORTAL_URL=https://stage.xtremenext.com/admin/Controlbase/Dashboard
ADMIN_LOGIN_URL=https://stage.xtremenext.com/admin/Login/index
ADMIN_USERNAME=madmin
ADMIN_PASSWORD=Test@1234
ADMIN_POST_LOGIN_URL_PATTERN=**/admin/Controlbase/**

# Developer 3: Client Portal
CLIENT_PORTAL_URL=https://stage.xtremenext.com/
CLIENT_LOGIN_URL=https://stage.xtremenext.com/login
CLIENT_USERNAME=
CLIENT_PASSWORD=
CLIENT_POST_LOGIN_URL_PATTERN=**/dashboard**

# ==============================================================================
# PLAYWRIGHT & BROWSER EXECUTION SETTINGS
# ==============================================================================
BROWSER_TYPE=chromium
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900
SCREENSHOT_ON_FAILURE=true
TRACE_ON_FAILURE=true
VIDEO_RECORDING=false

# ==============================================================================
# DOM REGRESSION: CLIENT PORTAL (BASELINE & LIVE)
# ==============================================================================
BASELINE_URL=https://stage.xtremenext.com/
BASELINE_TEST_USER_EMAIL=
BASELINE_TEST_USER_PASSWORD=
BASELINE_POST_LOGIN_URL_PATTERN=**/dashboard**

LIVE_URL=https://stage.xtremenext.com/
LIVE_TEST_USER_EMAIL=
LIVE_TEST_USER_PASSWORD=
LIVE_POST_LOGIN_URL_PATTERN=**/dashboard**

ENABLE_TRADE_TESTS=false

# ==============================================================================
# DOM REGRESSION: ADMIN PANEL (BASELINE & LIVE)
# ==============================================================================
BASELINE_ADMIN_BASE_URL=https://stage.xtremenext.com/admin/Controlbase/Dashboard
BASELINE_ADMIN_LOGIN_URL=https://stage.xtremenext.com/admin/Login/index
BASELINE_ADMIN_USER_USERNAME=
BASELINE_ADMIN_USER_PASSWORD=
BASELINE_ADMIN_POST_LOGIN_URL_PATTERN=**/admin/Controlbase/**

LIVE_ADMIN_BASE_URL=https://stage.xtremenext.com/admin/Controlbase/Dashboard
LIVE_ADMIN_LOGIN_URL=https://stage.xtremenext.com/admin/Login/index
LIVE_ADMIN_USER_USERNAME=
LIVE_ADMIN_USER_PASSWORD=
LIVE_ADMIN_POST_LOGIN_URL_PATTERN=**/admin/Controlbase/**

# ==============================================================================
# DOM REGRESSION: CRAWLER SAFETY & TIMEOUT SETTINGS
# ==============================================================================
CRAWLER_MAX_DEPTH=10
CRAWLER_MAX_PAGES=100
CRAWLER_WAIT_AFTER_LOAD=1000
CRAWLER_TIMEOUT=60000
CRAWLER_HEADLESS=true
# CRAWLER_ALLOWED_DOMAINS=stage.xtremenext.com
