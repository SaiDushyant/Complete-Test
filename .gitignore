# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS (NEVER COMMIT SENSITIVE DATA)
# ==============================================================================
.env
.env.*
!.env.example

# ==============================================================================
# AUTHENTICATION STORAGE STATES & COOKIE DUMPS
# ==============================================================================
auth_state*.json
auth/*.json
!auth/.gitkeep

# ==============================================================================
# PYTHON BYTECODE, CACHES & VIRTUAL ENVIRONMENTS
# ==============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/

# ==============================================================================
# TESTING & COVERAGE ARTIFACTS
# ==============================================================================
.pytest_cache/
.coverage
htmlcov/
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# ==============================================================================
# GENERATED TEST REPORTS & RUN ARTIFACTS
# ==============================================================================
reports/workflows/*
!reports/workflows/.gitkeep
reports/workflows/screenshots/*
!reports/workflows/screenshots/.gitkeep
reports/workflows/traces/*
!reports/workflows/traces/.gitkeep
reports/workflows/diagnostics/*
!reports/workflows/diagnostics/.gitkeep
reports/workflows/logs/*
!reports/workflows/logs/.gitkeep
reports/workflows/history/*

reports/validations/*
!reports/validations/.gitkeep
reports/validations/screenshots/*
!reports/validations/screenshots/.gitkeep
reports/validations/traces/*
!reports/validations/traces/.gitkeep
reports/validations/diagnostics/*
!reports/validations/diagnostics/.gitkeep
reports/validations/logs/*
!reports/validations/logs/.gitkeep
reports/validations/history/*

reports/mock/*
!reports/mock/.gitkeep
reports/mock/screenshots/*
!reports/mock/screenshots/.gitkeep
reports/mock/traces/*
!reports/mock/traces/.gitkeep
reports/mock/diagnostics/*
!reports/mock/diagnostics/.gitkeep
reports/mock/logs/*
!reports/mock/logs/.gitkeep
reports/mock/history/*

reports/ui_regression/*
!reports/ui_regression/.gitkeep
reports/ui_regression/history/*
reports/*.html
reports/*.xml

playwright-report/
test-results/
comparison_report*.json
workflows/**/reports/

